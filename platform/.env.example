# Copy to .env and fill in. Never commit .env.
DOMAIN=deals.example.com

# Two-factor sign-in. APP_SECRET encrypts two-factor secrets in the database: set it once to a long random value
# (for example: openssl rand -hex 32) and keep it with your backups. Losing it locks 2FA users out (admins can reset them).
APP_SECRET=
# off (default) | admin | all: who must set up two-factor before they can use the app
REQUIRE_2FA=admin

# Counterparty screening (see README). The file is a name list you download and refresh; the folder is mounted read-only into the app.
#SANCTIONS_FILE=/sanctions/list.csv
#SCREENING_WEBHOOK_URL=
#SCREENING_API_KEY=

# Open-source model (needs: docker compose --profile ollama up -d, then: docker compose exec ollama ollama pull llama3.1:8b)
#LLM_PROVIDER=ollama
#LLM_BASE_URL=http://ollama:11434/v1
#LLM_MODEL=llama3.1:8b

# Email to buyers (see README). Start with an allowlist while testing.
#MAIL_PROVIDER=resend
#MAIL_API_KEY=
#MAIL_FROM=Deals <deals@example.com>
#MAIL_ALLOWED_DOMAINS=example.com
